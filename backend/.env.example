# VaultLab

VAULT_DB_HOST=localhost
VAULT_DB_PORT=5432
VAULT_DB_NAME=vaultlab
VAULT_DB_USER=vaultlab
VAULT_DB_PASSWORD=vaultlab
VAULT_DB_SSLMODE=disable

VAULT_REDIS_ADDR=localhost:6379
VAULT_REDIS_PASSWORD=

VAULT_JWT_SECRET=change-me-in-production
VAULT_JWT_ACCESS_TTL=15m
VAULT_JWT_REFRESH_TTL=72h

VAULT_SERVER_PORT=8080
VAULT_SERVER_HOST=0.0.0.0

VAULT_LOG_LEVEL=debug

VAULT_YAHOO_FINANCE_ENABLED=true
VAULT_PRICE_FETCH_INTERVAL=1h
