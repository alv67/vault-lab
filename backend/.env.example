# Peculium

PECULIUM_DB_HOST=localhost
PECULIUM_DB_PORT=5432
PECULIUM_DB_NAME=peculium
PECULIUM_DB_USER=peculium
PECULIUM_DB_PASSWORD=peculium
PECULIUM_DB_SSLMODE=disable

PECULIUM_REDIS_ADDR=localhost:6379
PECULIUM_REDIS_PASSWORD=

PECULIUM_JWT_SECRET=change-me-in-production
PECULIUM_JWT_ACCESS_TTL=15m
PECULIUM_JWT_REFRESH_TTL=72h

PECULIUM_SERVER_PORT=8080
PECULIUM_SERVER_HOST=0.0.0.0

PECULIUM_LOG_LEVEL=debug

PECULIUM_YAHOO_FINANCE_ENABLED=true
PECULIUM_PRICE_FETCH_INTERVAL=1h

# TTL of the cached provider exposure payloads in Redis (keys
# vl:lookup:exposure:<source>:<isin>); force refetch with ?refresh=1.
PECULIUM_EXPOSURE_CACHE_TTL=168h
